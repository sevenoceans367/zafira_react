# PHP clsSettings          →  Node .env
# $admin_site              →  DB_HOST
# $admin_sitedatabase      →  DB_NAME
# $admin_siteuser          →  DB_USER
# $admin_sitepass          →  DB_PASSWORD

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zafira

MODULE_ID=6
COMPANY_ID=1
USER_ID=1

PORT=3000

# Optional — proxy to legacy getvesselwithinrangeapi.php when set
# VESSEL_WITHIN_RANGE_API_URL=http://your-php-host/path/getvesselwithinrangeapi.php

# Optional — Seametrix APIs (defaults match PHP getportapi.php / options.php case 82–83)
# SEAMETRIX_ROUTES_URL=https://apipro.seametrix.net/api/GetRoutes?AccessKey=your-key
# SEAMETRIX_PORTS_URL=https://api-stolt.seametrix.net/api/GetPorts?AccessKey=your-key

# Optional market defaults used on Add Estimate / vessel select
# OIL_PRICE_VLSFO=450
# OIL_PRICE_MGO=650
# EUA_CARBON_EUR=70
# EUA_TO_USD=1.08
# SDR_TO_USD=1.35
